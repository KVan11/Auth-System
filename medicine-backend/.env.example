# KHÔNG dùng database hay tài khoản của Auth backend.
MEDICINE_DATABASE_URL=

# Cổng HTTP của Medicine backend
MEDICINE_PORT=3001

# Origin của frontend được phép gọi Medicine API (mặc định http://localhost:5173)
MEDICINE_FRONTEND_ORIGIN=http://localhost:5173

# GIỐNG HỆT JWT_SECRET trong backend/.env
MEDICINE_JWT_SECRET=

MEDICINE_TEST_DATABASE_URL=
MEDICINE_TEST_DATABASE_MARKER=
